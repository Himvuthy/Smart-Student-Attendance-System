-- =====================================================
-- SMART ATTENDANCE SYSTEM DATABASE
-- Part 1
-- Tables:
-- 1. role
-- 2. entity
-- 3. useraccount
-- 4. major
-- 5. class
-- =====================================================

DROP TABLE IF EXISTS class CASCADE;
DROP TABLE IF EXISTS major CASCADE;
DROP TABLE IF EXISTS useraccount CASCADE;
DROP TABLE IF EXISTS entity CASCADE;
DROP TABLE IF EXISTS role CASCADE;

-- =====================================================
-- ROLE
-- =====================================================

CREATE TABLE role (
    roleid INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    rolename VARCHAR(50) NOT NULL UNIQUE,
    description TEXT
);

-- =====================================================
-- ENTITY
-- =====================================================

CREATE TABLE entity (
    eid INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    roleid INT NOT NULL,

    fullname VARCHAR(150) NOT NULL,

    gender VARCHAR(10)
        CHECK (gender IN ('Male','Female','Other')),

    dateofbirth DATE NOT NULL,

    phonenumber VARCHAR(20),

    bio TEXT,

    profilepicture TEXT,

    createdat DATE DEFAULT CURRENT_DATE,

    lastedit DATE DEFAULT CURRENT_DATE,

    CONSTRAINT fk_entity_role
        FOREIGN KEY (roleid)
        REFERENCES role(roleid)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
);

-- =====================================================
-- USER ACCOUNT
-- =====================================================

CREATE TABLE useraccount (

    userid INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    eid INT NOT NULL UNIQUE,

    username VARCHAR(100) UNIQUE,

    email VARCHAR(255) UNIQUE NOT NULL,

    passwordhash TEXT,

    lastlogin TIMESTAMP,

    CONSTRAINT fk_useraccount_entity
        FOREIGN KEY (eid)
        REFERENCES entity(eid)
        ON UPDATE CASCADE
        ON DELETE CASCADE
);

-- =====================================================
-- MAJOR
-- =====================================================

CREATE TABLE major (

    majorid INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    majorname VARCHAR(100) NOT NULL UNIQUE
);

-- =====================================================
-- CLASS
-- =====================================================

CREATE TABLE class (

    classid INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    majorid INT NOT NULL,

    classname VARCHAR(100) NOT NULL,

    classcode VARCHAR(30) NOT NULL UNIQUE,

    academicyear VARCHAR(20) NOT NULL,

    semester SMALLINT NOT NULL
        CHECK (semester BETWEEN 1 AND 4),

    CONSTRAINT fk_class_major
        FOREIGN KEY (majorid)
        REFERENCES major(majorid)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
);

-- =====================================================
-- INDEXES
-- =====================================================

CREATE INDEX idx_entity_role
ON entity(roleid);

CREATE INDEX idx_useraccount_email
ON useraccount(email);

CREATE INDEX idx_useraccount_username
ON useraccount(username);

CREATE INDEX idx_class_major
ON class(majorid);

