-- =====================================================
-- SMART ATTENDANCE SYSTEM DATABASE
-- Part 2
-- Tables:
-- 6. lecturer
-- 7. student
-- 8. enrollment
-- 9. schedule
-- 10. assignment
-- =====================================================

-- =====================================================
-- LECTURER
-- =====================================================

CREATE TABLE lecturer (

    lecturerid INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    eid INT NOT NULL UNIQUE,

    classid INT NOT NULL,

    subject VARCHAR(100) NOT NULL,

    CONSTRAINT fk_lecturer_entity
        FOREIGN KEY (eid)
        REFERENCES entity(eid)
        ON DELETE CASCADE,

    CONSTRAINT fk_lecturer_class
        FOREIGN KEY (classid)
        REFERENCES class(classid)
        ON DELETE RESTRICT
);

-- =====================================================
-- STUDENT
-- =====================================================

CREATE TABLE student (

    studentid INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    eid INT NOT NULL UNIQUE,

    CONSTRAINT fk_student_entity
        FOREIGN KEY (eid)
        REFERENCES entity(eid)
        ON DELETE CASCADE
);

-- =====================================================
-- ENROLLMENT
-- =====================================================

CREATE TABLE enrollment (

    studentid INT NOT NULL,

    classid INT NOT NULL,

    PRIMARY KEY (studentid, classid),

    CONSTRAINT fk_enrollment_student
        FOREIGN KEY (studentid)
        REFERENCES student(studentid)
        ON DELETE CASCADE,

    CONSTRAINT fk_enrollment_class
        FOREIGN KEY (classid)
        REFERENCES class(classid)
        ON DELETE CASCADE
);

-- =====================================================
-- SCHEDULE
-- =====================================================

CREATE TABLE schedule (

    scheduleid INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    classid INT NOT NULL,

    subject VARCHAR(100) NOT NULL,

    starttime TIME NOT NULL,

    endtime TIME NOT NULL,

    dayofweek VARCHAR(10) NOT NULL
        CHECK (dayofweek IN (
            'Monday',
            'Tuesday',
            'Wednesday',
            'Thursday',
            'Friday',
            'Saturday',
            'Sunday'
        )),

    CONSTRAINT fk_schedule_class
        FOREIGN KEY (classid)
        REFERENCES class(classid)
        ON DELETE CASCADE
);

-- =====================================================
-- ASSIGNMENT
-- =====================================================

CREATE TABLE assignment (

    lecturerid INT NOT NULL,

    scheduleid INT NOT NULL,

    PRIMARY KEY (lecturerid, scheduleid),

    CONSTRAINT fk_assignment_lecturer
        FOREIGN KEY (lecturerid)
        REFERENCES lecturer(lecturerid)
        ON DELETE CASCADE,

    CONSTRAINT fk_assignment_schedule
        FOREIGN KEY (scheduleid)
        REFERENCES schedule(scheduleid)
        ON DELETE CASCADE
);

-- =====================================================
-- INDEXES
-- =====================================================

CREATE INDEX idx_student_eid
ON student(eid);

CREATE INDEX idx_lecturer_eid
ON lecturer(eid);

CREATE INDEX idx_schedule_class
ON schedule(classid);

CREATE INDEX idx_enrollment_class
ON enrollment(classid);

-- =====================================================
-- END OF PART 2
-- =====================================================

-- =====================================================
-- SMART ATTENDANCE SYSTEM DATABASE
-- Part 3
-- Tables:
-- 11. session
-- 12. attendance
-- 13. biometric
-- 14. device
-- =====================================================

-- =====================================================
-- SESSION
-- =====================================================

CREATE TABLE session (

    sessionid INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    scheduleid INT NOT NULL,

    sessiondate DATE NOT NULL,

    CONSTRAINT fk_session_schedule
        FOREIGN KEY (scheduleid)
        REFERENCES schedule(scheduleid)
        ON UPDATE CASCADE
        ON DELETE CASCADE
);

CREATE INDEX idx_session_schedule
ON session(scheduleid);

CREATE INDEX idx_session_date
ON session(sessiondate);

-- =====================================================
-- DEVICE
-- =====================================================

CREATE TABLE device (

    deviceid INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    classid INT NOT NULL,

    devicename VARCHAR(100) NOT NULL,

    lastseen TIMESTAMP,

    location VARCHAR(255),

    CONSTRAINT fk_device_class
        FOREIGN KEY (classid)
        REFERENCES class(classid)
        ON UPDATE CASCADE
        ON DELETE CASCADE
);

CREATE INDEX idx_device_class
ON device(classid);

-- =====================================================
-- BIOMETRIC
-- =====================================================

CREATE TABLE biometric (

    biometricid INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    studentid INT NOT NULL UNIQUE,

    fingerindex SMALLINT NOT NULL
        CHECK (fingerindex BETWEEN 0 AND 9),

    template TEXT NOT NULL,

    createdat DATE DEFAULT CURRENT_DATE,

    CONSTRAINT fk_biometric_student
        FOREIGN KEY (studentid)
        REFERENCES student(studentid)
        ON UPDATE CASCADE
        ON DELETE CASCADE
);

CREATE INDEX idx_biometric_student
ON biometric(studentid);

-- =====================================================
-- ATTENDANCE
-- =====================================================

CREATE TABLE attendance (

    attendanceid INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    studentid INT NOT NULL,

    sessionid INT NOT NULL,

    deviceid INT,

    status VARCHAR(20) NOT NULL
        CHECK (
            status IN (
                'Present',
                'Late',
                'Absent',
                'Excused'
            )
        ),

    attendedat TIMESTAMP NOT NULL,

    minutelate INTEGER DEFAULT 0
        CHECK (minutelate >= 0),

    CONSTRAINT uq_attendance
        UNIQUE(studentid, sessionid),

    CONSTRAINT fk_attendance_student
        FOREIGN KEY (studentid)
        REFERENCES student(studentid)
        ON UPDATE CASCADE
        ON DELETE CASCADE,

    CONSTRAINT fk_attendance_session
        FOREIGN KEY (sessionid)
        REFERENCES session(sessionid)
        ON UPDATE CASCADE
        ON DELETE CASCADE,

    CONSTRAINT fk_attendance_device
        FOREIGN KEY (deviceid)
        REFERENCES device(deviceid)
        ON UPDATE CASCADE
        ON DELETE SET NULL
);

CREATE INDEX idx_attendance_student
ON attendance(studentid);

CREATE INDEX idx_attendance_session
ON attendance(sessionid);

CREATE INDEX idx_attendance_device
ON attendance(deviceid);

CREATE INDEX idx_attendance_status
ON attendance(status);

-- =====================================================
-- END OF PART 3
-- =====================================================

-- =====================================================
-- SMART ATTENDANCE SYSTEM DATABASE
-- Part 4
-- Tables:
-- 15. notificationtype
-- 16. notificationlog
-- 17. devicelog
-- 18. systemlog
-- =====================================================

-- =====================================================
-- NOTIFICATION TYPE
-- =====================================================

CREATE TABLE notificationtype (

    notificationtypeid INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    typename VARCHAR(100) NOT NULL UNIQUE,

    description TEXT
);

-- =====================================================
-- NOTIFICATION LOG
-- =====================================================

CREATE TABLE notificationlog (

    notificationid INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    studentid INT,

    notificationtypeid INT NOT NULL,

    title VARCHAR(200) NOT NULL,

    message TEXT NOT NULL,

    sentat TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    status VARCHAR(20)
        DEFAULT 'Sent'
        CHECK (status IN ('Sent','Pending','Failed')),

    CONSTRAINT fk_notification_student
        FOREIGN KEY (studentid)
        REFERENCES student(studentid)
        ON DELETE CASCADE,

    CONSTRAINT fk_notification_type
        FOREIGN KEY (notificationtypeid)
        REFERENCES notificationtype(notificationtypeid)
        ON DELETE RESTRICT
);

CREATE INDEX idx_notification_student
ON notificationlog(studentid);

CREATE INDEX idx_notification_type
ON notificationlog(notificationtypeid);

-- =====================================================
-- DEVICE LOG
-- =====================================================

CREATE TABLE devicelog (

    logid INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    deviceid INT NOT NULL,

    eventtype VARCHAR(100) NOT NULL,

    description TEXT,

    createdat TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_devicelog_device
        FOREIGN KEY (deviceid)
        REFERENCES device(deviceid)
        ON DELETE CASCADE
);

CREATE INDEX idx_devicelog_device
ON devicelog(deviceid);

-- =====================================================
-- SYSTEM LOG
-- =====================================================

CREATE TABLE systemlog (

    systemlogid INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    userid INT,

    action VARCHAR(255) NOT NULL,

    tablename VARCHAR(100),

    recordid INT,

    ipaddress VARCHAR(45),

    createdat TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_systemlog_user
        FOREIGN KEY (userid)
        REFERENCES useraccount(userid)
        ON DELETE SET NULL
);

CREATE INDEX idx_systemlog_user
ON systemlog(userid);

CREATE INDEX idx_systemlog_date
ON systemlog(createdat);

